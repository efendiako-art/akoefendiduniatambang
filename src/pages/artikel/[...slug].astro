---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { SITE, AD_SLOTS, categoryName, findSub, subUrl } from '../../consts';
import { categoryHubs, categoryHref } from '../../lib/nav';
import { readingTime, formatDate, figureize } from '../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('artikel', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props;
const { Content, headings } = await render(post);
// isi artikel yang sudah jadi HTML; gambar tunggal diberi keterangan otomatis
const html = post.rendered?.html ? figureize(post.rendered.html) : null;
const { title, description, pubDate, updatedDate, category, subcategory, tags, image, imageAlt } = post.data;
const sub = findSub(category, subcategory);
const catHref = categoryHref(await categoryHubs(), category);
const toc = headings.filter((h) => h.depth === 2);
const related = all
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, score: (p.data.category === category ? 2 : 0) + (sub && p.data.subcategory === sub.slug ? 3 : 0) + p.data.tags.filter((t) => tags.includes(t)).length }))
  .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 3)
  .map((r) => r.p);

const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate ?? pubDate).toISOString(),
      author: { '@type': 'Person', name: SITE.author },
      publisher: { '@type': 'Organization', name: SITE.name },
      mainEntityOfPage: url,
      inLanguage: 'id-ID',
      ...(image ? { image: [new URL(image, Astro.site).toString()] } : {}),
      ...(tags.length ? { keywords: tags.join(', ') } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: categoryName(category), item: new URL(catHref, Astro.site).toString() },
        ...(sub ? [{ '@type': 'ListItem', position: 3, name: sub.name, item: new URL(subUrl(category, sub.slug), Astro.site).toString() }] : []),
        { '@type': 'ListItem', position: sub ? 4 : 3, name: title, item: url },
      ],
    },
  ],
};
const share = encodeURIComponent(`${title} ${url}`);
---
<BaseLayout title={title} description={description} type="article" publishedTime={pubDate} jsonLd={jsonLd} image={image}>
  <div class="progress" id="progress" aria-hidden="true"></div>
  <article class="container art">
    <header class="head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Beranda</a> / <a href={catHref}>{categoryName(category)}</a>
        {sub && <> / <a href={subUrl(category, sub.slug)}>{sub.name}</a></>}
      </nav>
      <h1>{title}</h1>
      <p class="desc">{description}</p>
      <div class="meta">
        <span>{SITE.author}</span>
        <span>·</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span>· diperbarui {formatDate(updatedDate)}</span>}
        <span>·</span>
        <span>{readingTime(post.body ?? '')} menit baca</span>
      </div>
      {image && (
        <figure class="cover">
          <img src={image} alt={imageAlt || title} width="1200" height="675" fetchpriority="high" decoding="async" />
        </figure>
      )}
    </header>

    <div class="layout">
      <aside class="toc-wrap">
        {toc.length > 0 && (
          <details class="toc card" open>
            <summary>Daftar isi</summary>
            <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          </details>
        )}
        <div class="sidebar-ad"><AdSlot slot={AD_SLOTS.sidebar} /></div>
      </aside>

      <div class="main">
        <AdSlot slot={AD_SLOTS.articleTop} />
        {html ? <div class="prose" set:html={html} /> : <div class="prose"><Content /></div>}
        <AdSlot slot={AD_SLOTS.articleBottom} />

        <div class="tags">{tags.map((t) => <span class="tag">#{t}</span>)}</div>

        <aside class="author card" aria-label="Tentang penulis">
          <strong>Tentang penulis</strong>
          <p>
            Artikel ini ditulis oleh {SITE.author}, dikelola oleh praktisi yang bekerja sebagai Manager Operation di perusahaan jasa pertambangan.
            Rumus dan contoh hitungan dicek ulang sebelum terbit, dan angka dalam contoh bersifat ilustrasi kecuali disebut lain.
            Menemukan kekeliruan? <a href="/kontak/">Beri tahu kami</a>. Kenali lebih jauh di halaman <a href="/tentang/">Tentang TambangPedia</a>.
          </p>
        </aside>

        <div class="share card">
          <strong>Bermanfaat? Bagikan ke rekan tambang Anda</strong>
          <div class="share-btns">
            <a class="btn btn-primary" href={`https://wa.me/?text=${share}`} target="_blank" rel="noopener">WhatsApp</a>
            <a class="btn btn-ghost" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">LinkedIn</a>
            <a class="btn btn-ghost" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Facebook</a>
          </div>
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section related">
      <div class="container">
        <div class="section-head"><div><p class="eyebrow">Baca juga</p><h2>Artikel terkait</h2></div></div>
        <div class="grid">{related.map((p) => <ArticleCard post={p} />)}</div>
      </div>
    </section>
  )}
</BaseLayout>

<script is:inline>
  (function () {
    var bar = document.getElementById('progress');
    function upd() {
      var h = document.documentElement, max = h.scrollHeight - h.clientHeight;
      bar.style.transform = 'scaleX(' + (max > 0 ? h.scrollTop / max : 0) + ')';
    }
    addEventListener('scroll', upd, { passive: true }); upd();
  })();
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); z-index: 60; }
  .art { padding-top: 40px; padding-bottom: 24px; }
  .head { max-width: 820px; margin-bottom: 32px; }
  .crumbs { font-size: 14px; color: var(--ink-3); }
  .crumbs a { color: var(--ink-3); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  h1 { font-size: clamp(32px, 5vw, 50px); font-weight: 800; margin: 14px 0 14px; letter-spacing: -0.025em; }
  .desc { font-size: 20px; color: var(--ink-2); margin: 0 0 18px; line-height: 1.55; }
  .cover { margin: 26px 0 0; }
  .cover img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; display: block; border-radius: var(--radius); border: 1px solid var(--line); background: var(--bg-sunk); }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; font-size: 14px; color: var(--ink-3); }
  .layout { display: grid; gap: 32px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1000px) {
    .layout { grid-template-columns: 250px minmax(0, 1fr); gap: 56px; }
    .toc-wrap { order: 0; position: sticky; top: 88px; display: flex; flex-direction: column; gap: 20px; }
    .toc { position: static; }
  }
  .sidebar-ad { display: none; }
  @media (min-width: 1000px) { .sidebar-ad { display: block; } }
  .toc { padding: 16px 18px; font-size: 14.5px; }
  .toc summary { font: 700 14px/1 var(--font-head); cursor: pointer; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-2); }
  .toc ul { margin: 12px 0 0; padding: 0; list-style: none; }
  .toc li { margin: 8px 0; line-height: 1.4; }
  .toc a { color: var(--ink-2); text-decoration: none; }
  .toc a:hover { color: var(--accent); }
  .main { min-width: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0; }
  .tag { font-size: 13px; color: var(--ink-3); background: var(--bg-sunk); padding: 4px 10px; border-radius: 999px; }
  .author { padding: 20px; max-width: var(--readw); margin-bottom: 16px; }
  .author p { margin: 8px 0 0; color: var(--ink-2); font-size: 15.5px; line-height: 1.6; }
  .share { padding: 20px; max-width: var(--readw); display: flex; flex-direction: column; gap: 12px; }
  .share-btns { display: flex; gap: 8px; flex-wrap: wrap; }
  .share .btn { padding: 10px 16px; font-size: 14px; }
  .related { background: var(--bg-sunk); margin-top: 32px; }
</style>
