---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { SITE, AD_SLOTS, sopCategoryName } from '../../consts';

export async function getStaticPaths() {
  const docs = await getCollection('sop', ({ data }) => !data.draft);
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc, all: docs } }));
}

const { doc, all } = Astro.props;
const { Content, headings } = await render(doc);
const { title, description, docCode, docType, category, pdfFile } = doc.data;
const toc = headings.filter((h) => h.depth === 2);
const related = all.filter((d) => d.id !== doc.id && d.data.category === category).slice(0, 3);
const pdfHref = `/sop/${pdfFile}`;
const url = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'DigitalDocument',
      name: title,
      description,
      inLanguage: 'id-ID',
      publisher: { '@type': 'Organization', name: SITE.name },
      encodingFormat: 'application/pdf',
      url,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: 'SOP & IK', item: new URL('/sop/', Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: title, item: url },
      ],
    },
  ],
};
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="container art">
    <header class="head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Beranda</a> / <a href="/sop/">SOP &amp; IK</a></nav>
      <div class="tagline">
        <span class:list={['badge', docType === 'IK' ? 'ik' : 'sop']}>{docType === 'IK' ? 'Instruksi Kerja' : 'SOP'}</span>
        <span class="code">{docCode}</span>
        <span class="cat">{sopCategoryName(category)}</span>
      </div>
      <h1>{title}</h1>
      <p class="desc">{description}</p>
    </header>

    <div class="layout">
      <aside class="side">
        {toc.length > 0 && (
          <details class="toc card" open>
            <summary>Isi dokumen</summary>
            <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          </details>
        )}
        <div class="sidebar-ad"><AdSlot slot={AD_SLOTS.sidebar} /></div>
      </aside>

      <div class="main">
        <AdSlot slot={AD_SLOTS.sopTop} />
        <div class="prose"><Content /></div>

        <section class="download card" id="unduh">
          <div>
            <strong>Unduh dokumen ini (PDF)</strong>
            <p>{docCode} · {title}. Gratis, boleh disesuaikan untuk kebutuhan internal tim Anda.</p>
          </div>
          <a class="btn btn-primary" href={pdfHref} download>Unduh PDF</a>
        </section>

        <AdSlot slot={AD_SLOTS.sopBottom} />

        <a class="back" href="/sop/">← Kembali ke daftar SOP &amp; IK</a>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section related">
      <div class="container">
        <div class="section-head"><div><p class="eyebrow">Dokumen lain</p><h2>{sopCategoryName(category)}</h2></div></div>
        <ul class="rel">
          {related.map((d) => (
            <li class="card"><a href={`/sop/${d.id}/`}><span class="code">{d.data.docCode}</span>{d.data.title}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .art { padding-top: 40px; padding-bottom: 24px; }
  .head { max-width: 820px; margin-bottom: 32px; }
  .crumbs { font-size: 14px; color: var(--ink-3); }
  .crumbs a { color: var(--ink-3); text-decoration: none; }
  .tagline { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 16px; }
  .badge { font: 800 12px/1 var(--font-head); padding: 6px 9px; border-radius: 4px; color: #fff; background: var(--accent); }
  .badge.ik { background: #4f7f72; }
  .code { font: 600 13px/1 ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--ink-3); }
  .cat { font-size: 14px; color: var(--ink-2); }
  h1 { font-size: clamp(30px, 4.6vw, 46px); font-weight: 800; margin: 14px 0; letter-spacing: -0.025em; }
  .desc { font-size: 19px; color: var(--ink-2); margin: 0; line-height: 1.55; }
  .layout { display: grid; gap: 32px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1000px) {
    .layout { grid-template-columns: 250px minmax(0, 1fr); gap: 56px; }
    .side { position: sticky; top: 88px; align-self: start; display: flex; flex-direction: column; gap: 20px; }
  }
  .sidebar-ad { display: none; }
  @media (min-width: 1000px) { .sidebar-ad { display: block; } }
  .toc { padding: 16px 18px; font-size: 14.5px; }
  .toc summary { font: 700 14px/1 var(--font-head); cursor: pointer; color: var(--ink-2); }
  .toc ul { margin: 12px 0 0; padding: 0; list-style: none; }
  .toc li { margin: 8px 0; line-height: 1.4; }
  .toc a { color: var(--ink-2); text-decoration: none; }
  .toc a:hover { color: var(--accent); }
  .main { min-width: 0; }
  .prose :global(blockquote) { font-size: 15px; }
  .download { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 22px 24px; margin: 36px 0; max-width: var(--readw); border-left: 4px solid var(--accent); }
  .download p { margin: 6px 0 0; color: var(--ink-2); font-size: 14.5px; }
  .back { display: inline-block; margin-top: 24px; font-size: 15px; }
  .related { background: var(--bg-sunk); margin-top: 32px; }
  .rel { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .rel li a { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px; color: var(--ink); text-decoration: none; font-weight: 600; }
</style>
