---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { SOP_CATEGORIES, AD_SLOTS, sopCategoryName } from '../../consts';

const docs = (await getCollection('sop', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.docCode.localeCompare(b.data.docCode),
);
const EVERY = 6;
---
<BaseLayout
  title="Contoh SOP & Instruksi Kerja Tambang (Gratis Unduh PDF)"
  description="Kumpulan contoh format SOP dan Instruksi Kerja (IK) pertambangan terbuka dan nikel: operasional, K3, perawatan alat, dan stockpile. Baca online atau unduh PDF gratis."
>
  <section class="page container">
    <p class="eyebrow">Pustaka dokumen</p>
    <h1>Contoh SOP &amp; Instruksi Kerja Tambang</h1>
    <p class="lead">Format contoh SOP dan IK untuk tambang terbuka, termasuk tambang nikel. Setiap dokumen bisa dibaca langsung dan diunduh satu per satu dalam bentuk PDF.</p>
    <p class="note">Semua dokumen di sini adalah <strong>contoh generik untuk edukasi</strong>, bukan dokumen resmi perusahaan mana pun. Sesuaikan dengan kajian risiko dan kondisi site Anda sebelum dipakai.</p>

    <div class="pills" role="group" aria-label="Filter kategori">
      <button type="button" class="pill on" data-cat="">Semua ({docs.length})</button>
      {SOP_CATEGORIES.map((c) => (
        <button type="button" class="pill" data-cat={c.slug}>{c.name}</button>
      ))}
    </div>

    <div class="list" id="list">
      {docs.map((d, i) => (
        <>
          <article class="card doc" data-category={d.data.category}>
            <div class="doc-head">
              <span class:list={['badge', d.data.docType === 'IK' ? 'ik' : 'sop']}>{d.data.docType}</span>
              <span class="code">{d.data.docCode}</span>
            </div>
            <h2><a href={`/sop/${d.id}/`}>{d.data.title}</a></h2>
            <p>{d.data.description}</p>
            <div class="doc-foot">
              <span class="cat">{sopCategoryName(d.data.category)}</span>
              <span class="go">PDF · Lihat &amp; unduh</span>
            </div>
          </article>
          {AD_SLOTS.sopInFeed && (i + 1) % EVERY === 0 && i !== docs.length - 1 && (
            <div class="in-feed"><AdSlot slot={AD_SLOTS.sopInFeed} /></div>
          )}
        </>
      ))}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var items = [].slice.call(document.querySelectorAll('#list > .doc'));
    document.querySelectorAll('.pill').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('.pill').forEach(function (x) { x.classList.remove('on'); });
        b.classList.add('on');
        var c = b.dataset.cat;
        items.forEach(function (el) { el.style.display = !c || el.dataset.category === c ? '' : 'none'; });
      });
    });
  })();
</script>

<style>
  .note { font-size: 14.5px; color: var(--ink-2); background: var(--bg-sunk); border-left: 3px solid var(--accent); padding: 12px 16px; border-radius: 6px; max-width: 720px; margin: 18px 0 24px; }
  .note strong { color: var(--ink); }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .pill { padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--bg-elev); color: var(--ink-2); font: 500 14px/1 var(--font-body); cursor: pointer; }
  .pill.on { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .list { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .doc { position: relative; padding: 20px 22px; display: flex; flex-direction: column; gap: 10px; border-top: 3px solid var(--accent); transition: transform .2s; }
  .doc:hover { transform: translateY(-3px); }
  .doc-head { display: flex; align-items: center; gap: 10px; }
  .badge { font: 800 12px/1 var(--font-head); padding: 5px 8px; border-radius: 4px; color: #fff; background: var(--accent); }
  .badge.ik { background: #4f7f72; }
  .code { font: 600 12.5px/1 ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--ink-3); }
  .doc h2 { font-size: 19px; margin: 2px 0 0; line-height: 1.3; }
  .doc h2 a { color: var(--ink); text-decoration: none; }
  .doc h2 a::after { content: ''; position: absolute; inset: 0; }
  .doc p { margin: 0; color: var(--ink-2); font-size: 15px; line-height: 1.6; flex: 1; }
  .doc-foot { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; padding-top: 10px; border-top: 1px solid var(--line); }
  .cat { color: var(--ink-3); }
  .go { color: var(--accent-ink); font-weight: 600; }
  .in-feed { grid-column: 1 / -1; }
</style>
