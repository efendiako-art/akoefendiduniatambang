---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import AppBanner from '../components/AppBanner.astro';
import MineOps from '../components/MineOps.astro';
import MineSide from '../components/MineSide.astro';
import OrbitEco from '../components/OrbitEco.astro';
import { SITE, CATEGORIES, AD_SLOTS } from '../consts';
import { categoryHubs, categoryHref, monogram } from '../lib/nav';
import { getCollection as getAll } from 'astro:content';

const posts = (await getCollection('artikel', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 6);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.slug, posts.filter((p) => p.data.category === c.slug).length]));

const hubs = await categoryHubs();
const sopCount = (await getAll('sop', ({ data }) => !data.draft)).length;
// kode kartu topik, contoh OP-01, TS-02 (dari huruf awal nama kategori)
const topics = CATEGORIES.map((c, i) => ({
  ...c, href: categoryHref(hubs, c.slug), count: counts[c.slug] ?? 0, subs: (c.sub ?? []).length,
  code: `${monogram(c.name)}-${String(i + 1).padStart(2, '0')}`,
}));
const stages = [
  { t: '01 Loading', c: 'st-load' },
  { t: '02 Hauling', c: 'st-haul' },
  { t: '03 Dumping', c: 'st-dump' },
  { t: '04 Dozing', c: 'st-doze' },
];
const ecoColors = ['#5FE3D5', '#FFB067', '#7FF0B5', '#FF7A5C', '#B9A4FF', '#FFC400'];
const ecoItems = [
  ...topics.map((c, i) => ({ code: monogram(c.name), name: c.name, sub: c.subs > 0 ? `${c.subs} sub-topik · ${c.count} artikel` : `${c.count} artikel`, href: c.href, c: ecoColors[i % ecoColors.length] })),
  { code: 'KL', name: 'Kalkulator', sub: 'KPI, SR, produktivitas', href: '/alat/', c: '#FFB067' },
  { code: 'SOP', name: 'SOP & IK', sub: `${sopCount} dokumen contoh`, href: '/sop/', c: '#7FF0B5' },
  { code: 'APK', name: 'Aplikasi Android', sub: 'Eng 3D Calculation', href: '/aplikasi/', c: '#B9A4FF' },
];
const ecoStats = `${CATEGORIES.length} TOPIK · ${posts.length} ARTIKEL · 3 KALKULATOR`;
const siteUrl = Astro.site?.toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: SITE.name,
      alternateName: ['Tambang Pedia', 'tambangpedia.com'],
      url: siteUrl,
      description: SITE.description,
      inLanguage: 'id-ID',
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: SITE.name,
      url: siteUrl,
      logo: { '@type': 'ImageObject', url: new URL('/logo.png', Astro.site).toString(), width: 512, height: 512 },
      email: SITE.email,
    },
  ],
};
---
<BaseLayout jsonLd={jsonLd}>
  <!-- ===== HERO ===== -->
  <section class="hero">
    <svg class="net" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1">
        <path d="M60 120 L260 60 L420 170 L640 90 L820 200 L1040 70 L1260 160 L1400 80" />
        <path d="M260 60 L330 300 L560 260 L640 90" />
        <path d="M1040 70 L980 320 L1180 390 L1260 160" />
        <path d="M120 520 L330 300 L460 600 L700 690 L560 260" />
        <path d="M1180 390 L1380 520 L1220 700 L980 620 L980 320" />
      </g>
      <g fill="currentColor">
        <circle cx="260" cy="60" r="2.5" /><circle cx="420" cy="170" r="2" /><circle cx="640" cy="90" r="2.5" /><circle cx="1040" cy="70" r="2.5" />
        <circle cx="1260" cy="160" r="2" /><circle cx="330" cy="300" r="2.5" /><circle cx="560" cy="260" r="2" /><circle cx="980" cy="320" r="2.5" />
        <circle cx="1180" cy="390" r="2" /><circle cx="460" cy="600" r="2" /><circle cx="1380" cy="520" r="2.5" /><circle cx="1220" cy="700" r="2" />
      </g>
    </svg>
    <svg class="hexbg" aria-hidden="true">
      <defs>
        <pattern id="hexp" width="120" height="69.28" patternUnits="userSpaceOnUse">
          <path d="M20 0 L60 0 L80 34.64 L60 69.28 L20 69.28 L0 34.64 Z M80 34.64 L120 34.64" fill="none" stroke="#5FE3D5" stroke-opacity=".10" stroke-width="1" />
        </pattern>
      </defs>
      <g class="hexmove"><rect x="-240" y="-140" width="200%" height="200%" fill="url(#hexp)" /></g>
    </svg>
    <div class="container hero-grid">
      <div class="hero-text">
        <span class="pill-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2l2.5 6.5L21 11l-6.5 2.5L12 20l-2.5-6.5L3 11l6.5-2.5z" /></svg>
          Portal edukasi pertambangan
        </span>
        <h1>Ilmu Tambang dari Lapangan</h1>
        <p class="sub">Dijelaskan sederhana. Bisa langsung dihitung.</p>
        <p class="lead">Rumus produksi, KPI alat berat, tutorial software tambang, geologi, K3, dan karier — ditulis praktisi, lengkap dengan kalkulator yang bisa dipakai di lapangan.</p>
        <div class="cta">
          <a class="btn btn-primary" href="/artikel/">Baca artikel <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
          <a class="btn btn-ghost" href="/alat/">Coba kalkulator</a>
          <a class="btn btn-line" href="/aplikasi/">Unduh aplikasi</a>
        </div>
        <div class="stats">
          <div class="stat"><b>{posts.length}</b><span>Artikel praktis</span></div>
          <div class="stat"><b>{sopCount}</b><span>Contoh SOP &amp; IK</span></div>
          <div class="stat"><b>3</b><span>Kalkulator online</span></div>
          <div class="stat"><b>Gratis</b><span>Web &amp; Android</span></div>
        </div>
      </div>

      <div class="hero-visual">
        <MineOps />
      </div>
    </div>
    <div class="container chips-row">
      {stages.map((st) => <span class:list={['htag', st.c]}>{st.t}</span>)}
    </div>
    <div class="side-wrap"><MineSide /></div>
  </section>

  <div class="container"><AdSlot slot={AD_SLOTS.homeBelowHero} /></div>

  <!-- ===== TOPIK ===== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Jelajahi topik</p><h2>Satu portal. Semua topik tambang.</h2></div>
        <a href="/artikel/">Semua artikel →</a>
      </div>
      <div class="topics">
        {topics.map((c) => (
          <a class="card topic" href={c.href}>
            <div class="topic-top"><span class="code">{c.code}</span><span class="topic-n">{c.subs > 0 ? `${c.subs} sub-topik · ${c.count} artikel` : `${c.count} artikel`}</span></div>
            <h3>{c.name}</h3>
            <p>{c.desc}</p>
            <span class="more">Buka topik →</span>
          </a>
        ))}
        <a class="topic topic-all" href="/artikel/">
          <h3>Semua artikel</h3>
          <p>Cari topik atau saring per kategori.</p>
          <span class="more">Lihat pustaka →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== ORBIT EKOSISTEM ===== -->
  <OrbitEco items={ecoItems} stats={ecoStats} />

  <!-- ===== KALKULATOR ===== -->
  <section class="section tools-band">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Alat gratis</p><h2>Hitung langsung di browser</h2></div>
        <a href="/alat/">Semua kalkulator →</a>
      </div>
      <div class="grid">
        <a class="card tool" href="/alat/kpi-alat/"><span class="num">01</span><h3>KPI Alat: PA, UA, MA, EU</h3><p>Masukkan jam kerja, perbaikan, dan siaga — availability muncul seketika.</p><span class="more">Buka kalkulator →</span></a>
        <a class="card tool" href="/alat/stripping-ratio/"><span class="num">02</span><h3>Stripping Ratio &amp; BESR</h3><p>Hitung SR aktual dan titik impas tambang dari harga jual dan biaya.</p><span class="more">Buka kalkulator →</span></a>
        <a class="card tool" href="/alat/produktivitas/"><span class="num">03</span><h3>Produktivitas Excavator &amp; Truk</h3><p>Produksi per jam, jumlah truk ideal, dan match factor armada.</p><span class="more">Buka kalkulator →</span></a>
      </div>
    </div>
  </section>

  <!-- ===== ARTIKEL TERBARU ===== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Terbaru</p><h2>Artikel pilihan</h2></div>
        <a href="/artikel/">Lihat semua →</a>
      </div>
      <div class="grid">{latest.map((p) => <ArticleCard post={p} />)}</div>
    </div>
  </section>

  <AppBanner />

  <!-- ===== AJAKAN ===== -->
  <section class="section cta-band">
    <div class="container">
      <h2>Punya pertanyaan, koreksi, atau usulan topik?</h2>
      <p>Tulis ke redaksi — kami balas dalam 2–3 hari kerja.</p>
      <div class="cta center">
        <a class="btn btn-primary" href="/kontak/">Kirim pesan ke redaksi</a>
        <a class="btn btn-ghost" href="/tentang/">Tentang TambangPedia</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; color: var(--hero-ink); background: radial-gradient(60% 70% at 85% 30%, rgba(47,184,172,.14), transparent 70%), radial-gradient(50% 60% at 10% 90%, rgba(226,64,27,.16), transparent 70%), var(--hero); padding: 64px 0 56px; }
  .hexbg { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .55; pointer-events: none; }
  .hexmove { animation: hexdrift 26s linear infinite; }
  @keyframes hexdrift { to { transform: translate(-120px, -69.28px); } }
  @media (prefers-reduced-motion: reduce) { .hexmove { animation: none; } }
  .side-wrap { position: relative; max-width: 1440px; margin: 8px auto -56px; }
  .net { position: absolute; inset: 0; width: 100%; height: 100%; color: #5FE3D5; opacity: .2; }
  .hero-grid { position: relative; display: grid; gap: 40px; align-items: center; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); } }
  .hero h1 { color: #fff; font: 800 clamp(40px, 6vw, 66px)/1.03 var(--font-head); letter-spacing: -0.03em; margin: 22px 0 14px; }
  .hero .sub { font: 700 clamp(19px, 2.2vw, 24px)/1.3 var(--font-head); color: #5FE3D5; margin: 0 0 16px; }
  .hero .lead { font-size: clamp(16px, 1.8vw, 18px); line-height: 1.65; color: #B4BFCC; margin: 0 0 28px; max-width: 560px; }
  .hero .pill-badge { color: #FFB067; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta.center { justify-content: center; }
  .hero .btn { padding: 15px 22px; }
  .hero .btn-ghost { color: #fff; border-color: rgba(255,255,255,.22); background: rgba(255,255,255,.04); }
  .hero .btn-line { border-color: #2FB8AC; color: #5FE3D5; }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-top: 34px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.09); }
  @media (max-width: 560px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .stat { padding: 16px; border-radius: 14px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.09); display: flex; flex-direction: column; gap: 6px; }
  .stat b { font: 800 26px/1 var(--font-head); color: #fff; }
  .stat span { font-size: 13px; line-height: 1.35; color: #9AA6B5; }
  .hero-visual { position: relative; width: 100%; max-width: 620px; aspect-ratio: 800 / 760; margin: 0 auto; }
  @media (min-width: 1000px) { .hero-visual { max-width: none; margin: 0; } }
  .chips-row { position: relative; display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
  .htag { padding: 9px 14px; border-radius: 999px; border: 1px solid rgba(95,227,213,.35); color: #8FF0E6; font: 600 12px/1 var(--font-body); letter-spacing: .1em; text-transform: uppercase; }
  .htag { font-family: var(--font-brand); letter-spacing: .08em; }
  .st-haul { border-color: rgba(247,164,58,.5); color: #FFB067; }
  .st-dump { border-color: rgba(255,196,0,.5); color: #FFD25A; }
  .st-doze { border-color: rgba(185,164,255,.5); color: #CBBEFF; }

  .section-head a { font-weight: 600; text-decoration: none; }
  .topics { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); }
  .topic { padding: 22px; display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--ink); transition: transform .2s, border-color .2s; }
  .topic:hover { transform: translateY(-3px); border-color: rgba(247,164,58,.5); color: var(--ink); }
  .topic-top { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
  .code { font: 800 13px/1 var(--font-brand); letter-spacing: .08em; color: var(--cyan); }
  .topic-n { font-size: 12.5px; color: var(--ink-3); text-align: right; }
  .topic h3 { margin: 0; font-size: 19px; }
  .topic p { margin: 0; color: var(--ink-2); font-size: 14.5px; line-height: 1.55; flex: 1; }
  .more { color: var(--accent-ink); font: 600 14px/1 var(--font-body); }
  .topic-all { border-radius: var(--radius); border: 1px dashed rgba(247,164,58,.5); justify-content: center; }

  .tools-band { background: linear-gradient(180deg, var(--cyan-soft), transparent 70%); border-top: 1px solid var(--line); }
  .tool { padding: 26px; display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--ink); transition: transform .2s, border-color .2s; }
  .tool:hover { transform: translateY(-3px); border-color: rgba(95,227,213,.45); color: var(--ink); }
  .num { font: 800 13px/1 var(--font-brand); color: var(--cyan); }
  .tool h3 { margin: 4px 0 0; font-size: 21px; }
  .tool p { margin: 0; color: var(--ink-2); font-size: 15px; line-height: 1.6; flex: 1; }

  .cta-band { text-align: center; border-top: 1px solid var(--line); }
  .cta-band h2 { font-size: clamp(26px, 3.4vw, 38px); margin: 0 auto 12px; max-width: 760px; }
  .cta-band p { color: var(--ink-2); font-size: 17px; margin: 0 0 26px; }
</style>
