---
/**
 * Slot iklan Google AdSense.
 * - Jika ADSENSE_CLIENT & slot terisi  -> menampilkan iklan asli.
 * - Jika belum & PUBLIC_AD_PREVIEW=1   -> menampilkan kotak penanda posisi (hanya untuk pratinjau).
 * - Selain itu                          -> tidak menampilkan apa pun (aman saat review AdSense).
 */
import { ADSENSE_CLIENT } from '../consts';
interface Props { slot?: string; format?: 'auto' | 'fluid'; label?: string }
const { slot = '', format = 'auto', label = 'Iklan' } = Astro.props;
const live = Boolean(ADSENSE_CLIENT && slot);
const preview = !live && import.meta.env.PUBLIC_AD_PREVIEW === '1';
---
{live && (
  <aside class="ad" aria-label="Iklan">
    <span class="ad-label">{label}</span>
    <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot}
      data-ad-format={format} data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
{preview && (
  <aside class="ad ad-preview" aria-hidden="true">
    <span>Posisi iklan AdSense</span>
  </aside>
)}
<style>
  .ad { margin: 32px 0; text-align: center; }
  .ad-label { display: block; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 6px; }
  .ad-preview { display: grid; place-items: center; min-height: 120px; border: 1.5px dashed var(--line); border-radius: var(--radius-sm); color: var(--ink-3); font-size: 13px; background: repeating-linear-gradient(135deg, transparent 0 10px, var(--bg-sunk) 10px 20px); }
</style>
