---
import type { CollectionEntry } from 'astro:content';
import { categoryName } from '../consts';
import { readingTime, formatDate } from '../utils';
import TopicIcon from './TopicIcon.astro';
interface Props { post: CollectionEntry<'artikel'>; big?: boolean }
const { post, big = false } = Astro.props;
const { title, description, pubDate, category } = post.data;
---
<article class:list={['card', 'acard', { big }]} data-category={category} data-search={`${title} ${description}`.toLowerCase()}>
  <div class="art" aria-hidden="true" data-cat={category}>
    <TopicIcon slug={post.id} />
  </div>
  <div class="body">
    <a class="chip" href={`/kategori/${category}/`}>{categoryName(category)}</a>
    <h3><a href={`/artikel/${post.id}/`}>{title}</a></h3>
    <p>{description}</p>
    <div class="meta"><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> · {readingTime(post.body ?? '')} menit baca</div>
  </div>
</article>
<style>
  .acard { overflow: hidden; display: flex; flex-direction: column; transition: transform .2s, box-shadow .2s; position: relative; }
  .acard:hover { transform: translateY(-3px); }
  .art {
    height: 132px; background: var(--hero); position: relative; display: grid; place-items: center;
    background-image: radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 68%);
  }
  .art :global(.topic-icon) { position: relative; z-index: 1; color: var(--accent); }
  .art[data-cat='alat-berat'] { background-image: radial-gradient(circle at 50% 42%, color-mix(in srgb, #e0b04a 22%, transparent), transparent 68%); }
  .art[data-cat='alat-berat'] :global(.topic-icon) { color: #e0b04a; }
  .art[data-cat='geologi-eksplorasi'] { background-image: radial-gradient(circle at 50% 42%, color-mix(in srgb, #7fb6a4 22%, transparent), transparent 68%); }
  .art[data-cat='geologi-eksplorasi'] :global(.topic-icon) { color: #7fb6a4; }
  .art[data-cat='k3-tambang'] { background-image: radial-gradient(circle at 50% 42%, color-mix(in srgb, #e46a5a 22%, transparent), transparent 68%); }
  .art[data-cat='k3-tambang'] :global(.topic-icon) { color: #e46a5a; }
  .art[data-cat='karier-regulasi'] { background-image: radial-gradient(circle at 50% 42%, color-mix(in srgb, #9aa7e0 22%, transparent), transparent 68%); }
  .art[data-cat='karier-regulasi'] :global(.topic-icon) { color: #9aa7e0; }
  .body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .body .chip { align-self: flex-start; position: relative; z-index: 2; }
  h3 { margin: 4px 0 0; font-size: 20px; }
  .big h3 { font-size: 26px; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  p { margin: 0; color: var(--ink-2); font-size: 15.5px; line-height: 1.6; flex: 1; }
  .meta { font-size: 13px; color: var(--ink-3); }
</style>
