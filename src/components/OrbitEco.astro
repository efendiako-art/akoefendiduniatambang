---
// Orbit ekosistem: kartu topik/fitur berputar mengelilingi inti TAMBANGPEDIA (model Minergo).
// Di layar kecil atau saat "kurangi gerakan" aktif, kartu tampil sebagai daftar biasa.
interface Item { code: string; name: string; sub: string; href: string; c: string; img?: string }
interface Props { items: Item[]; stats: string }
const { items, stats } = Astro.props;
---
<section class="eco" aria-labelledby="eco-title">
  <div class="eco-grid-bg" aria-hidden="true"></div>
  <div class="container eco-head">
    <span class="eco-pill">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3" /><ellipse cx="12" cy="12" rx="10" ry="4" /></svg>
      Ekosistem TambangPedia
    </span>
    <h2 id="eco-title">Satu Portal. Semua Ilmu Tambang.</h2>
    <p>Artikel, tutorial software, kalkulator, SOP, dan aplikasi saling terhubung dalam satu pusat pengetahuan tambang.</p>
  </div>

  <div class="container">
    <div class="stage" data-orbit>
      <svg class="rings" viewBox="0 0 1180 600" preserveAspectRatio="none" aria-hidden="true">
        <ellipse cx="590" cy="300" rx="507" ry="216" fill="none" stroke="rgba(95,227,213,.22)" stroke-width="1.2" stroke-dasharray="4 8" />
        <ellipse cx="590" cy="300" rx="400" ry="160" fill="none" stroke="rgba(247,164,58,.16)" stroke-width="1" />
        <ellipse cx="590" cy="300" rx="610" ry="262" fill="none" stroke="rgba(255,255,255,.05)" stroke-width="1" />
      </svg>
      <div class="core-base" aria-hidden="true"></div>
      <div class="core">
        <span class="core-pill">PUSAT ILMU TAMBANG</span>
        <span class="core-name">TAMBANG<span>PEDIA</span></span>
        <span class="core-sub">EDUKASI · KALKULATOR · APLIKASI</span>
        <span class="core-stats">{stats}</span>
      </div>
      <ul class="cards">
        {items.map((it) => (
          <li class="oc-li">
            <a class:list={['ocard', { hot: !!it.img }]} href={it.href} {...(it.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
              {it.img
                ? <span class="oic oimg" style={`border:1px solid ${it.c}`}><img src={it.img} width="38" height="38" alt="" loading="lazy" /></span>
                : <span class="oic" style={`color:${it.c};border:1px solid ${it.c}66;background:${it.c}1A`}>{it.code}</span>}
              <span class="otext"><span class="oname">{it.name}</span><span class="osub">{it.sub}</span></span>
              <span class="odot" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="eco-ctrl">
      <button type="button" class="pausebtn" data-orbit-toggle aria-pressed="false">Jeda orbit</button>
      <span>Arahkan kursor ke kartu untuk berhenti, klik untuk membuka.</span>
    </div>
  </div>
</section>

<script>
  function initOrbit() {
    const stage = document.querySelector<HTMLElement>('[data-orbit]');
    if (!stage || stage.dataset.ready) return;
    stage.dataset.ready = '1';
    const lis = Array.from(stage.querySelectorAll<HTMLElement>('.oc-li'));
    const btn = document.querySelector<HTMLButtonElement>('[data-orbit-toggle]');
    const wide = window.matchMedia('(min-width: 900px)');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let t = 0, last: number | null = null, paused = reduce.matches, hover = false, raf = 0, visible = true;
    const n = lis.length;
    const place = () => {
      lis.forEach((li, i) => {
        const a = t + (i * Math.PI * 2) / n;
        const sin = Math.sin(a), cos = Math.cos(a), d = (sin + 1) / 2;
        li.style.left = (50 + 43 * cos).toFixed(3) + '%';
        li.style.top = (50 + 36 * sin).toFixed(3) + '%';
        li.style.transform = `translate(-50%,-50%) scale(${(0.74 + 0.3 * d).toFixed(3)})`;
        li.style.opacity = (0.45 + 0.55 * d).toFixed(3);
        li.style.zIndex = sin > -0.12 ? '30' : '5';
      });
    };
    const clear = () => lis.forEach((li) => li.removeAttribute('style'));
    const loop = (ts: number) => {
      if (last == null) last = ts;
      const dt = Math.min(64, ts - last); last = ts;
      if (!paused && !hover && visible) { t = (t + dt * 0.00011) % (Math.PI * 2); place(); }
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      cancelAnimationFrame(raf); last = null;
      if (wide.matches) { stage.classList.add('is-orbit'); place(); raf = requestAnimationFrame(loop); }
      else { stage.classList.remove('is-orbit'); clear(); }
    };
    stage.addEventListener('mouseover', (e) => { if ((e.target as HTMLElement).closest('.ocard')) hover = true; });
    stage.addEventListener('mouseout', (e) => { if ((e.target as HTMLElement).closest('.ocard')) hover = false; });
    stage.addEventListener('focusin', () => { hover = true; });
    stage.addEventListener('focusout', () => { hover = false; });
    const label = () => { if (btn) { btn.textContent = paused ? 'Putar orbit' : 'Jeda orbit'; btn.setAttribute('aria-pressed', String(paused)); } };
    btn?.addEventListener('click', () => { paused = !paused; label(); });
    label();
    new IntersectionObserver((en) => { visible = en[0].isIntersecting; }).observe(stage);
    wide.addEventListener('change', start);
    start();
  }
  initOrbit();
  document.addEventListener('astro:page-load', initOrbit);
</script>

<style>
  .eco { position: relative; overflow: hidden; color: #EAF0F6; padding: 76px 0 64px; background: radial-gradient(55% 60% at 50% 55%, rgba(47,211,194,.12), transparent 70%), radial-gradient(40% 50% at 15% 20%, rgba(226,64,27,.10), transparent 70%), #05080D; }
  .eco-grid-bg { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 64px 64px; }
  .eco-head { position: relative; text-align: center; }
  .eco-pill { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; border: 1px solid rgba(62,224,143,.45); background: rgba(62,224,143,.08); color: #7FF0B5; font: 600 12px/1 var(--font-body); letter-spacing: .12em; text-transform: uppercase; }
  .eco h2 { color: #fff; font: 800 clamp(30px, 4vw, 46px)/1.1 var(--font-head); letter-spacing: -0.02em; margin: 18px 0 12px; }
  .eco-head p { font-size: clamp(16px, 1.8vw, 17.5px); line-height: 1.6; color: #B4BFCC; margin: 0 auto; max-width: 640px; }

  .stage { position: relative; margin-top: 28px; }
  .rings, .core-base { display: none; }
  .core { position: relative; margin: 0 auto 22px; max-width: 520px; padding: 22px 16px; border-radius: 999px; background: radial-gradient(60% 70% at 50% 40%, rgba(47,211,194,.20), rgba(8,16,22,.96) 70%); border: 2px solid #2FD3C2; box-shadow: 0 0 46px rgba(47,211,194,.35), inset 0 0 40px rgba(47,211,194,.2); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px; text-align: center; }
  .core-pill { padding: 5px 11px; border-radius: 999px; border: 1px solid rgba(62,224,143,.5); background: rgba(62,224,143,.1); color: #7FF0B5; font: 600 10.5px/1 var(--font-body); letter-spacing: .14em; }
  .core-name { font: 900 clamp(24px, 5vw, 34px)/1 var(--font-brand); letter-spacing: .14em; color: #FF5A00; -webkit-text-stroke: 1px #FF5A00; filter: drop-shadow(0 0 12px rgba(255,90,0,.55)); }
  .core-name span { color: #FFC400; -webkit-text-stroke-color: #FFC400; }
  .core-sub { font: 700 12px/1 var(--font-brand); letter-spacing: .2em; color: #5FE3D5; }
  .core-stats { font: 600 11.5px/1 var(--font-body); letter-spacing: .08em; color: #B4BFCC; }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); }
  .ocard { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 14px; background: linear-gradient(180deg, rgba(22,30,42,.92), rgba(12,17,25,.92)); border: 1px solid rgba(255,255,255,.1); box-shadow: 0 14px 34px rgba(0,0,0,.45); color: #EAF0F6; text-decoration: none; }
  .ocard:hover, .ocard:focus-visible { border-color: rgba(95,227,213,.7); color: #fff; }
  .ocard.hot { border-color: rgba(255,196,0,.75); background: linear-gradient(180deg, rgba(40,28,10,.95), rgba(14,11,7,.95)); box-shadow: 0 0 22px rgba(255,140,0,.35), 0 14px 34px rgba(0,0,0,.45); }
  .ocard.hot:hover, .ocard.hot:focus-visible { border-color: #FFC400; }
  .ocard.hot .oname { color: #FFC400; }
  .ocard.hot .osub { color: #7FF0B5; }
  .oimg { overflow: hidden; padding: 0; }
  .oimg img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .oic { flex: none; width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; font: 800 11.5px/1 var(--font-brand); letter-spacing: .04em; }
  .otext { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .oname { font: 800 13px/1.2 var(--font-brand); letter-spacing: .04em; color: #fff; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .osub { font: 500 12px/1.3 var(--font-body); color: #9AA6B5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .odot { flex: none; width: 7px; height: 7px; border-radius: 50%; background: #3EE08F; box-shadow: 0 0 10px #3EE08F; margin-left: auto; align-self: flex-start; }

  /* mode orbit (layar lebar) */
  .stage.is-orbit { height: 600px; }
  .stage.is-orbit .rings { display: block; position: absolute; inset: 0; width: 100%; height: 100%; }
  .stage.is-orbit .core-base { display: block; position: absolute; left: 50%; top: 50%; width: 520px; height: 180px; transform: translate(-50%, -36%); border-radius: 50%; background: linear-gradient(180deg, #0B1C22, #04080C); border: 1px solid rgba(47,211,194,.35); box-shadow: 0 30px 60px rgba(0,0,0,.6); z-index: 20; }
  .stage.is-orbit .core { position: absolute; left: 50%; top: 50%; width: 520px; height: 180px; margin: 0; padding: 0; transform: translate(-50%, -58%); border-radius: 50%; z-index: 21; }
  .stage.is-orbit .cards { display: block; position: absolute; inset: 0; }
  .stage.is-orbit .oc-li { position: absolute; width: 228px; will-change: transform, left, top; }

  .eco-ctrl { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 14px; margin-top: 14px; font-size: 13.5px; color: #8C98A7; }
  .pausebtn { display: none; padding: 11px 20px; border-radius: 999px; border: 1px solid rgba(95,227,213,.45); background: rgba(95,227,213,.08); color: #8FF0E6; font: 600 14px/1 var(--font-body); cursor: pointer; }
  .pausebtn:hover { background: rgba(95,227,213,.16); }
  .eco-ctrl span { display: none; }
  @media (min-width: 900px) { .pausebtn, .eco-ctrl span { display: inline-flex; } }
</style>
