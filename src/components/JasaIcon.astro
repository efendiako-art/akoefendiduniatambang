---
import { JASA_ICON } from '../data/jasa';
interface Props { icon: string; color: string; size?: number }
const { icon, color, size = 48 } = Astro.props;
---
<span class="jic" style={`width:${size}px;height:${size}px;background:${color}1A;border:1px solid ${color}66;color:${color}`}>
  <svg width={Math.round(size / 2)} height={Math.round(size / 2)} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={JASA_ICON[icon]} />
</span>
<style>
  .jic { flex: none; display: grid; place-items: center; border-radius: 14px; }
</style>
